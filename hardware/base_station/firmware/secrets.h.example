/**
 * PFUMA BS-02 — local secrets. Template - safe to commit.
 * Copy secrets.h.example to secrets.h and fill in your own values.
 */
#pragma once

#define WIFI_SSID   "YOUR_WIFI_NAME"
#define WIFI_PASS   "YOUR_WIFI_PASSWORD"

// PFUMA web app on the VPS. No trailing slash.
#define API_HOST    "https://your-server:8443"

// Shown once by the app when you pair this base station's serial (STATION_ID
// in base_station.ino) under a PFUMA account — copy it here right away, it's
// never shown again. Telemetry is rejected without a matching secret.
#define STATION_SECRET "PASTE_THE_DEVICE_SECRET_FROM_PAIRING_HERE"
