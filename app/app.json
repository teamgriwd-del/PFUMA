{
  "expo": {
    "name": "PFUMA",
    "slug": "pfuma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PFUMA needs access to your photos so you can attach a real photo of an animal or listing."
      }
    },
    "android": {
      "package": "com.griwd.pfuma",
      "adaptiveIcon": {
        "backgroundColor": "#1b5e20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PFUMA needs access to your photos so you can attach a real photo of an animal or listing."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1b5e20"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dbf5ba50-fea2-49e9-949a-fd7c5bc83e40"
      }
    },
    "owner": "teamgriwds-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dbf5ba50-fea2-49e9-949a-fd7c5bc83e40"
    }
  }
}
