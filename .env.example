# Copy to .env for local overrides, or set these in your host's dashboard.
# .env itself is gitignored — never commit real values.

# Where the Flask API lives, with no trailing slash.
# Leave unset locally and it falls back to http://localhost:5000.
# For a deployed build this MUST be a public https URL, because the browser
# resolves it on the visitor's device — localhost would mean their machine.
VITE_API_URL=https://your-api-host.example.com

# The Flask backend reads this for signing JWTs. Set it on the API host;
# without it the server falls back to an insecure dev default and warns.
# PFUMA_SECRET_KEY=generate-a-long-random-string
